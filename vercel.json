{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    },
    "api/wec-signin.js": {
      "maxDuration": 300,
      "includeFiles": "{node_modules/@sparticuz/chromium/bin/**,node_modules/.pnpm/@sparticuz+chromium@*/node_modules/@sparticuz/chromium/bin/**}"
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://kongboda-motorsports-2026.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/",
      "destination": "/api/index?__path="
    },
    {
      "source": "/:path*",
      "destination": "/api/index?__path=:path"
    }
  ]
}
